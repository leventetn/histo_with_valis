// H&E registration parameter combinations that would otherwise fail late or obscurely.

nextflow_function {

    name "validateParams: H&E registration"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "validateParams"
    tag "unit"
    tag "validation"

    test("H&E registration on a whole-slide marker-sheet run is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_he_registration: true, he_micro_um: 'native' ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("a number of µm for he_micro_um, as text from the command line, is accepted") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_he_registration: true, he_micro_um: '0.5' ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("he_micro_um of 0 is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_he_registration: true, he_micro_um: 0 ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("he_micro_um must be native or a number of µm greater than 0") }
        }
    }

    test("H&E registration on a TMA is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: true, use_he_registration: true, he_micro_um: 'native',
                             use_tma_dearray: true, coreograph_args: '--downsampleFactor 5' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("TMA slides are not supported yet") }
        }
    }

    test("H&E registration with preprocessing_only is rejected") {
        when {
            function {
                """
                input[0] = [ use_preprocessing: true, preprocessing_only: true, use_he_registration: true, he_micro_um: 'native' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("use_he_registration with preprocessing_only") }
        }
    }

    test("H&E registration on pre-stitched input is rejected") {
        when {
            function {
                """
                input[0] = [ use_cellpose: true, use_preprocessing: false, use_he_registration: true, he_micro_um: 'native' ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("use_he_registration requires use_preprocessing") }
        }
    }
}

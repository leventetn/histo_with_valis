// The he_image column repeats on every cycle row of a sample, like marker_sheet: every copy must
// agree, and a sample names it on every row or on none. Rows follow schema property order, so the
// H&E is it[5]; keep new schema columns appended.

nextflow_function {

    name "validateHeImageColumn"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "validateHeImageColumn"
    tag "unit"
    tag "validation"

    test("cycles of one sample naming the same H&E are accepted") {
        when {
            function {
                """
                input[0] = [
                    [ [ id: 'slideA' ], 'c1.tif', [], [], '/data/markers.csv', '/data/he_A.svs' ],
                    [ [ id: 'slideA' ], 'c2.tif', [], [], '/data/markers.csv', '/data/he_A.svs' ]
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("one sample with an H&E and one without are accepted") {
        when {
            function {
                """
                input[0] = [
                    [ [ id: 'slideA' ], 'c1.tif', [], [], '/data/markers.csv', '/data/he_A.svs' ],
                    [ [ id: 'slideB' ], 'c1.tif', [], [], '/data/markers.csv', [] ]
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("one sample whose cycles name different H&E images is rejected") {
        when {
            function {
                """
                input[0] = [
                    [ [ id: 'slideA' ], 'c1.tif', [], [], '/data/markers.csv', '/data/he_A.svs' ],
                    [ [ id: 'slideA' ], 'c2.tif', [], [], '/data/markers.csv', '/data/he_B.svs' ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("Sample 'slideA'") }
            assert function.stdout.any { it.contains("must name the same he_image, or none") }
        }
    }

    test("one sample naming the H&E on some cycles only is rejected") {
        when {
            function {
                """
                input[0] = [
                    [ [ id: 'slideA' ], 'c1.tif', [], [], '/data/markers.csv', '/data/he_A.svs' ],
                    [ [ id: 'slideA' ], 'c2.tif', [], [], '/data/markers.csv', [] ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("Sample 'slideA'") }
            assert function.stdout.any { it.contains("(empty)") }
        }
    }
}
